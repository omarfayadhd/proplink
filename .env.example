# ── Database (Supabase — human task H1.2) ─────────────────────────────
DATABASE_URL=                 # Supabase pooled connection string
DIRECT_URL=                   # Supabase direct connection (for migrations)

# ── Auth ──────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=              # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=             # Google OAuth (human task H1.6)
GOOGLE_CLIENT_SECRET=

# ── Storage (AWS — human task H1.4) ───────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
S3_BUCKET=proplink-media-prod
CLOUDFRONT_URL=

# ── Cache / rate limiting (Upstash — human task H1.5) ─────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── AI (Anthropic — human task H1.9) ──────────────────────────────────
ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_GBP=100

# ── Maps (Google — human tasks H2.2, H3.1) ────────────────────────────
GOOGLE_MAPS_API_KEY=          # browser key, referrer-restricted
GOOGLE_MAPS_SERVER_KEY=       # server key for Geocoding + Routes API

# ── KYC (Sumsub — human tasks H1.10, H4.1) ────────────────────────────
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=

# ── Payments (Stripe — human task H5.1) ───────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Realtime (Pusher — human task H4.2) ───────────────────────────────
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu

# ── Email (Resend — human task H1.7) ──────────────────────────────────
RESEND_API_KEY=

# ── Gov data APIs (human task H1.10) ──────────────────────────────────
EPC_API_KEY=                  # EPC Register (free registration)
COMPANIES_HOUSE_API_KEY=      # free registration

# ── Monitoring (Sentry — human task H1.8) ─────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Feature flags (compliance-critical — see docs/ARCHITECTURE.md) ────
SYNDICATE_PAYMENTS_ENABLED=false
